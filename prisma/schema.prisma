generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal schema for Module 0 to prove database connection works.
// Detailed User, Room, etc. will be designed in their respective modules.
model SystemHealth {
  id        Int      @id @default(autoincrement())
  status    String
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  bio          String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshSessions RefreshSession[]
  rooms           Room[]
  participants    Participant[]
}

model RefreshSession {
  id              String    @id @default(uuid())
  userId          String
  jti             String    @unique
  tokenHash       String
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  replacedByJti   String?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum RoomStatus {
  ACTIVE
  ENDED
}

model Room {
  id              String     @id @default(uuid())
  name            String
  isPrivate       Boolean    @default(false)
  maxParticipants Int        @default(50)
  status                 RoomStatus @default(ACTIVE)
  activeParticipantCount Int        @default(0)

  hostId          String
  host            User       @relation(fields: [hostId], references: [id], onDelete: Cascade)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  endedAt         DateTime?

  participants    Participant[]

  @@index([hostId])
}

model Participant {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, leftAt]) // Efficiently query active participants
}
